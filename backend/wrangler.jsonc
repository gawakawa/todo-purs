{
  "name": "todo-purs",
  "main": "index.js",
  "compatibility_date": "2026-09-02",
  // global_fetch_strictly_public: httpServerHandler self-fetches the Worker's own URL;
  // without this flag that fails with error 1042 on workers.dev.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Top level = local dev (wrangler dev). No assets: the frontend is served by
  // the Vite dev server, which proxies /api to this Worker (see frontend/vite.config.js).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todo-purs",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // Production: serves frontend/dist as static assets alongside the API.
    // d1_databases is a non-inheritable key, so it must be repeated here with
    // the real database_id (see CONTRIBUTING.md).
    "production": {
      "name": "todo-purs",
      "assets": {
        "directory": "../frontend/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "todo-purs",
          "database_id": "f18ee28e-f2b8-4fc3-b1ae-18c30c9c47aa",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
